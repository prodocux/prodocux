{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/prodocux_content_blocks_v1.json",
  "title": "ProDocuX content blocks v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "blocks"],
  "properties": {
    "schema_version": {"const": "prodocux_content_blocks_v1"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[A-Za-z]{2,8}([-_][A-Za-z0-9]{1,8})?$"
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/$defs/block"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 8192},
    "cell": {"type": "string", "maxLength": 8192},
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows"],
      "properties": {
        "header_rows": {"type": "integer", "minimum": 0, "maximum": 8, "default": 1},
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {"$ref": "#/$defs/cell"}
          }
        }
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "type": {
          "enum": ["heading", "paragraphs", "table", "key_values", "sheet", "slide"]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "heading"}}, "required": ["type"]},
          "then": {
            "additionalProperties": false,
            "required": ["id", "type", "level", "text"],
            "properties": {
              "id": true,
              "type": {"const": "heading"},
              "level": {"type": "integer", "minimum": 1, "maximum": 6},
              "text": {"$ref": "#/$defs/text"}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "paragraphs"}}, "required": ["type"]},
          "then": {
            "additionalProperties": false,
            "required": ["id", "type", "paragraphs"],
            "properties": {
              "id": true,
              "type": {"const": "paragraphs"},
              "paragraphs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "items": {"$ref": "#/$defs/text"}
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "table"}}, "required": ["type"]},
          "then": {
            "additionalProperties": false,
            "required": ["id", "type", "table"],
            "properties": {
              "id": true,
              "type": {"const": "table"},
              "table": {"$ref": "#/$defs/table"}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "key_values"}}, "required": ["type"]},
          "then": {
            "additionalProperties": false,
            "required": ["id", "type", "pairs"],
            "properties": {
              "id": true,
              "type": {"const": "key_values"},
              "pairs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "value"],
                  "properties": {
                    "label": {"$ref": "#/$defs/text"},
                    "value": {"type": "string", "maxLength": 8192}
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "sheet"}}, "required": ["type"]},
          "then": {
            "additionalProperties": false,
            "required": ["id", "type", "name", "table"],
            "properties": {
              "id": true,
              "type": {"const": "sheet"},
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[^\\\\/?*\\[\\]:]{1,64}$"
              },
              "table": {"$ref": "#/$defs/table"}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "slide"}}, "required": ["type"]},
          "then": {
            "additionalProperties": false,
            "required": ["id", "type", "title"],
            "properties": {
              "id": true,
              "type": {"const": "slide"},
              "title": {"$ref": "#/$defs/text"},
              "paragraphs": {
                "type": "array",
                "maxItems": 50,
                "items": {"$ref": "#/$defs/text"}
              }
            }
          }
        }
      ]
    }
  }
}
