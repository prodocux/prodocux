{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/prodocux_render_result_v1.json",
  "title": "ProDocuX render result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "kernel_version",
    "renderer_id",
    "renderer_version",
    "target_format",
    "validation"
  ],
  "properties": {
    "schema_version": {"const": "prodocux_render_result_v1"},
    "status": {"enum": ["completed", "failed", "cancelled", "timed_out"]},
    "kernel_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "renderer_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "renderer_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "target_format": {"enum": ["docx", "xlsx", "csv", "pptx", "pdf"]},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed"],
      "properties": {
        "passed": {"type": "boolean"},
        "reasons": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": true
    },
    "content_b64": {"type": "string", "minLength": 1},
    "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "template_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed"}}},
      "then": {
        "required": ["media_type", "output_sha256"],
        "oneOf": [
          {
            "required": ["content_b64"],
            "not": {"required": ["artifact"]}
          },
          {
            "required": ["artifact"],
            "not": {"required": ["content_b64"]}
          }
        ]
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["failed", "cancelled", "timed_out"]}}},
      "then": {"required": ["error"]}
    }
  ]
}
