{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/prodocux_image_tile_projection_v1.json",
  "title": "ProDocuX image tile projection v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "source_sha256", "parser_contract", "image", "range", "tiles", "next_cursor", "coverage", "ocr", "counts"],
  "properties": {
    "schema_version": {"const": "prodocux_image_tile_projection_v1"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parser_contract": {"type": "object"}, "image": {"type": "object"}, "range": {"type": "object"},
    "tiles": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["tile_index", "x", "y", "width", "height", "rgba_sha256"], "properties": {"tile_index": {"type": "integer", "minimum": 0}, "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "rgba_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "next_cursor": {"type": ["object", "null"]}, "coverage": {"type": "object"}, "ocr": {"type": "object"}, "counts": {"type": "object"}
  }
}
