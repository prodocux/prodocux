{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/prodocux_archive_credential_binding_v2.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "prodocux_archive_credential_binding_v2"
    },
    "credential_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "authority_binding": {
      "type": "object",
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "authority_id",
        "tenant_id",
        "principal_id"
      ],
      "additionalProperties": false
    },
    "source_bundle_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expires_at_ms": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "delivery": {
      "enum": [
        "protected_pipe",
        "trusted_library_callback"
      ]
    },
    "revoked": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "credential_ref",
    "operation_id",
    "authority_binding",
    "source_bundle_digest",
    "expires_at_ms",
    "delivery",
    "revoked"
  ],
  "additionalProperties": false
}
