{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/prodocux_opaque_artifact_v1.json",
  "title": "ProDocuX opaque artifact identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "uri",
    "sha256",
    "size_bytes",
    "media_type"
  ],
  "properties": {
    "schema_version": {"const": "prodocux_opaque_artifact_v1"},
    "artifact_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^artifact://[a-zA-Z0-9_-]+/(?!(?:.*/)?\\.\\.(?:/|$))(?!(?:.*/)?\\.(?:/|$))[a-zA-Z0-9/_.-]+$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0, "maximum": 104857600},
    "media_type": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
