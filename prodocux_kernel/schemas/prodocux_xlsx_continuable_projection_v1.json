{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/prodocux_xlsx_continuable_projection_v1.json",
  "title": "ProDocuX XLSX continuable projection v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "source_sha256", "parser_contract", "range", "rows", "formula_cells", "next_cursor", "coverage", "counts"],
  "properties": {
    "schema_version": {"const": "prodocux_xlsx_continuable_projection_v1"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parser_contract": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "prodocux_xlsx_worksheet_row_projection_v1"}, "version": {"const": "1"}}},
    "range": {"type": "object", "additionalProperties": false, "required": ["unit", "sheet_index", "sheet_name", "start", "end", "requested_max_rows"], "properties": {"unit": {"const": "worksheet_row"}, "sheet_index": {"type": "integer", "minimum": 0}, "sheet_name": {"type": "string", "minLength": 1}, "start": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 2}, "requested_max_rows": {"type": "integer", "minimum": 1, "maximum": 500}}},
    "rows": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"type": "array", "maxItems": 32}},
    "formula_cells": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["cell", "formula", "cached_value"], "properties": {"cell": {"type": "string"}, "formula": {"type": "string"}, "cached_value": {}}}},
    "next_cursor": {"type": ["object", "null"]},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["disposition", "known_total_sheets", "known_sheet_rows", "continuation_available", "omitted_content_classes"], "properties": {"disposition": {"enum": ["complete", "partial_known", "partial_unknown"]}, "known_total_sheets": {"type": "integer", "minimum": 1}, "known_sheet_rows": {"type": "integer", "minimum": 1}, "continuation_available": {"type": "boolean"}, "omitted_content_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["returned_rows", "returned_columns"], "properties": {"returned_rows": {"type": "integer", "minimum": 1, "maximum": 500}, "returned_columns": {"type": "integer", "minimum": 1, "maximum": 32}}}
  }
}
