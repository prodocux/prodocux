{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/prodocux_archive_fixture_attestation_v2.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "prodocux_archive_fixture_attestation_v2"
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "entry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "variant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "immutable_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "size_bytes": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "expected_payload_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "rights_evidence_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rights": {
      "enum": [
        "own_generated",
        "redistribution_verified",
        "local_test_only"
      ]
    },
    "decoder_attestation_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution_status": {
      "enum": [
        "not_executed",
        "passed",
        "failed"
      ]
    }
  },
  "required": [
    "schema_version",
    "fixture_id",
    "entry_id",
    "variant",
    "source_url",
    "immutable_revision",
    "archive_sha256",
    "size_bytes",
    "expected_payload_sha256",
    "rights_evidence_digest",
    "rights",
    "decoder_attestation_digest",
    "execution_status"
  ],
  "additionalProperties": false
}
