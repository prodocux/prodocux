{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/prodocux_archive_source_lease_v2.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "prodocux_archive_source_lease_v2"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "authority_binding": {
      "type": "object",
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "authority_id",
        "tenant_id",
        "principal_id"
      ],
      "additionalProperties": false
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bundle": {
      "$ref": "https://prodocux.dev/schemas/prodocux_archive_common_v1.schema.json#/$defs/SourceBundle"
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "enum": [
        "active",
        "expired",
        "revoked",
        "closed"
      ]
    },
    "issued_at_ms": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "expires_at_ms": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "immutable": {
      "const": true
    },
    "storage_kind": {
      "enum": [
        "controlled_spool",
        "verified_immutable_store"
      ]
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "source_ref",
    "operation_id",
    "authority_binding",
    "policy_digest",
    "bundle",
    "bundle_digest",
    "state",
    "issued_at_ms",
    "expires_at_ms",
    "immutable",
    "storage_kind"
  ],
  "additionalProperties": false
}
