{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/prodocux_archive_source_admission_v2.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "prodocux_archive_source_admission_v2"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "authority_binding": {
      "type": "object",
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "authority_id",
        "tenant_id",
        "principal_id"
      ],
      "additionalProperties": false
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "enum": [
        "chunked_snapshot",
        "verified_immutable_store"
      ]
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ordinal": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "volume_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "declared_size_bytes": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ordinal",
          "volume_key",
          "declared_size_bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "upload_chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "volume_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "range": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "end": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "volume_key",
          "range",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "expected_bundle_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at_ms": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "operation_id",
    "authority_binding",
    "policy_digest",
    "mode",
    "volumes",
    "upload_chunks",
    "expected_bundle_digest",
    "expires_at_ms"
  ],
  "additionalProperties": false
}
