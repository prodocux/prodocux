{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/prodocux_pptx_continuable_projection_v1.json",
  "title": "ProDocuX PPTX continuable projection v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "source_sha256", "parser_contract", "range", "slides", "next_cursor", "coverage", "counts"],
  "properties": {
    "schema_version": {"const": "prodocux_pptx_continuable_projection_v1"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parser_contract": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "prodocux_pptx_slide_projection_v1"}, "version": {"const": "1"}}},
    "range": {"type": "object", "additionalProperties": false, "required": ["unit", "start", "end", "requested_max_slides"], "properties": {"unit": {"const": "slide"}, "start": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 2}, "requested_max_slides": {"type": "integer", "minimum": 1, "maximum": 50}}},
    "slides": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/slide"}},
    "next_cursor": {"type": ["object", "null"]},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["disposition", "known_total_slides", "continuation_available", "omitted_content_classes"], "properties": {"disposition": {"enum": ["complete", "partial_known", "partial_unknown"]}, "known_total_slides": {"type": "integer", "minimum": 1}, "continuation_available": {"type": "boolean"}, "omitted_content_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["returned_slides"], "properties": {"returned_slides": {"type": "integer", "minimum": 1, "maximum": 50}}}
  },
  "$defs": {
    "slide": {
      "type": "object", "additionalProperties": false,
      "required": ["slide_number", "shapes", "speaker_notes"],
      "properties": {
        "slide_number": {"type": "integer", "minimum": 1},
        "speaker_notes": {"type": "string"},
        "shapes": {"type": "array", "maxItems": 300, "items": {"$ref": "#/$defs/shape"}}
      }
    },
    "shape": {
      "type": "object", "additionalProperties": false,
      "required": ["shape_id", "shape_name", "text", "is_picture", "table"],
      "properties": {
        "shape_id": {"type": "integer", "minimum": 1},
        "shape_name": {"type": "string"},
        "text": {"type": "string"},
        "is_picture": {"type": "boolean"},
        "table": {"type": ["array", "null"]}
      }
    }
  }
}
