    "schema_version"
  ],
  "properties": {
    "version_authority": {
      "const": "stored_workflow_contract_version"
    },
    "caller_header_selectable": {
      "const": false
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "method",
          "path",
          "request_schema",
          "success_schema",
          "success_statuses",
          "role",
