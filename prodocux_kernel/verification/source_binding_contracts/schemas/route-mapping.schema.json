            "maxLength": 512
          },
          "request_schema": {
            "type": [
              "string",
              "null"
            ]
          },
          "success_schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "success_statuses": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 200,
              "maximum": 299
            },
            "maxItems": 3
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "error_owner": {
            "enum": [
              "kernel",
              "engine",
              "parent"
            ]
          }
        }
      },
      "maxItems": 2,
      "minItems": 2
    },
    "errors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel"
      ],
      "properties": {
        "kernel": {
          "type": "object",
