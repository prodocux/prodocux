{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pdx:draft:cr003:support:2",
  "$defs": {
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "media_type",
        "parser_contract",
        "normalization",
        "conversion",
        "locator",
        "ocr_supported",
        "search_selector_supported",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "const": "prodocux_source_binding_capabilities_draft_v2"
        },
        "media_type": {
          "const": "application/pdf"
        },
        "parser_contract": {
          "$ref": "urn:pdx:draft:cr003:core:1#/$defs/parser"
        },
        "normalization": {
          "const": "unicode_nfc_preserve_whitespace_codepoint_v1"
        },
        "conversion": {
          "const": "ascii_decimal_exact_scale_v1"
        },
        "locator": {
          "const": "page_exact_codepoint_range"
        },
        "ocr_supported": {
          "const": false
        },
        "search_selector_supported": {
          "const": false
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_source_bytes",
            "max_request_bytes",
            "max_page_number",
            "max_page_codepoints",
            "max_checks",
            "max_quote_codepoints",
            "max_value_codepoints",
            "max_decimal_scale",
            "max_integer_digits",
            "ocr_min_nonwhitespace_codepoints"
          ],
          "properties": {
            "max_source_bytes": {
              "const": 10485760
            },
            "max_request_bytes": {
              "const": 14000000
            },
            "max_page_number": {
              "const": 10000
            },
            "max_page_codepoints": {
              "const": 50000
            },
            "max_checks": {
              "const": 32
            },
            "max_quote_codepoints": {
              "const": 4096
            },
            "max_value_codepoints": {
              "const": 64
            },
            "max_decimal_scale": {
              "const": 8
            },
            "max_integer_digits": {
              "const": 18
            },
            "ocr_min_nonwhitespace_codepoints": {
              "const": 20
            }
          }
        }
      }
    }
  }
}
